# Cấu hình cổng chạy Backend (Mặc định 5000)
PORT=5000
NODE_ENV=production

# Chuỗi bí mật tạo Token JWT (Bắt buộc đổi chuỗi ngẫu nhiên dài khi chạy thật)
JWT_SECRET=thay_the_bang_chuoi_bi_mat_rat_dai_va_an_toan_2026_xyz

# Tên miền Frontend được phép gọi API qua CORS (nếu có nhiều domain thì cách nhau bằng dấu phẩy)
# Ví dụ: FRONTEND_URL=https://trolygv.edu.vn,https://app.trolygv.edu.vn
FRONTEND_URL=https://yourdomain.edu.vn
ALLOWED_ORIGINS=https://yourdomain.edu.vn,https://app.yourdomain.edu.vn
